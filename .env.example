# OmniShield-X Frontend Environment Variables
# Copy this file to .env or .env.local for local development.

# Production: Set to your live Render backend URL (e.g. https://omni-shield-x-backend.onrender.com)
# If unset on Vercel, the app automatically connects to https://omni-shield-x-backend.onrender.com
# Local development: Set to http://localhost:3001 or leave unset to use Vite dev proxy
VITE_API_URL=https://omni-shield-x-backend.onrender.com
VITE_WS_URL=https://omni-shield-x-backend.onrender.com
