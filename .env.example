# OmniShield-X Frontend Environment Variables
# Copy this file to .env or .env.local for local development.

# Production: Set to your live Render backend URL (e.g. https://omnishield-api.onrender.com)
# Local development: Leave unset to use Vite dev proxy or set to http://localhost:3001
VITE_API_URL=http://localhost:3001

# Real-time WebSocket URL (optional, defaults to VITE_API_URL if unset)
VITE_WS_URL=http://localhost:3001
