{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://omni-shield-x-backend.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://omni-shield-x-backend.onrender.com/socket.io/$1"
    },
    {
      "source": "/health",
      "destination": "https://omni-shield-x-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
